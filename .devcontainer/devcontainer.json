{
    "name": "ROS 2 Development Container",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "ros-humble",
    "workspaceFolder": "/home/cobot_ws",
    "remoteUser": "shapzonlinux",
    
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-themes",
                "twxs.cmake",
                "donjayamanne.python-extension-pack",
                "eamodio.gitlens",
                "ms-iot.vscode-ros"
            ]
        }
    },
    
    "containerEnv": {
        "DISPLAY": "unix:0",
        "ROS_LOCALHOST_ONLY": "1",
        "ROS_DOMAIN_ID": "42"
    },
    
    "postAttachCommand": "source /opt/ros/humble/setup.bash && echo '✅ ROS ready!'"
}